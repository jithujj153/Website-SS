# --- Site ---
# Canonical URL (used for metadata, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.system-smiths.com

# --- Contact form delivery: SMTP through your Hostinger mailbox ---
# Use the full mailbox address and its password (never commit real values; set them in your host's environment settings).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=connect@system-smiths.com
SMTP_PASS=7fii-ziw6-kavy-pynb
# Sender shown on the notification email. Hostinger needs this to be the mailbox itself (it defaults to SMTP_USER).
CONTACT_FROM_EMAIL=
# Where submissions are delivered
CONTACT_TO_EMAIL=connect@system-smiths.com

# --- Alternative to SMTP: Resend (https://resend.com). Only used if SMTP_USER / SMTP_PASS are empty. ---
RESEND_API_KEY=

# --- Optional: durable rate limiting across serverless instances (Upstash Redis REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (OFF by default). Set a GA4 measurement id to enable; it only loads after cookie consent. ---
NEXT_PUBLIC_GA_ID=
